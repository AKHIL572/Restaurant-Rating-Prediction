# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- pytest ---
.pytest_cache/
.coverage
htmlcov/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Power BI ---
# .pbix files themselves ARE tracked (this project's deliverable), but Power
# BI creates local temp/cache artifacts that should not be committed:
*.pbix.bak
~$*.pbix
Dashboard/*.tmp

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Environment / secrets ---
.env
*.env.local

# --- Large/regenerable artifacts (optional — see note below) ---
# Model/*.pkl is intentionally NOT ignored: the trained model is a real,
# reviewable deliverable of this project, not a throwaway build artifact.
# If your repo grows large, consider Git LFS for Dataset/Res_dataset.csv and
# Model/*.pkl instead of excluding them outright.